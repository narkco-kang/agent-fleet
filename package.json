{
  "name": "agent-fleet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "AgentFleet — 跨设备超级智能体协同系统",
  "workspaces": [
    "shared",
    "backend",
    "device-agent",
    "frontend",
    "wechat",
    "memory",
    "modelgateway"
  ],
  "scripts": {
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:agent": "npm run dev --workspace device-agent",
    "dev:local": "node scripts/dev-local.mjs",
    "dev:relay": "npm run relay --workspace backend",
    "dev:wechat": "npm run dev --workspace wechat",
    "dev:gateway": "npm run dev --workspace modelgateway",
    "build:shared": "npm run build --workspace shared",
    "build:backend": "npm run build --workspace backend",
    "build:frontend": "npm run build --workspace frontend",
    "build:agent": "npm run build --workspace device-agent",
    "build:wechat": "npm run build --workspace wechat",
    "build:memory": "npm run build --workspace memory",
    "build:gateway": "npm run build --workspace modelgateway",
    "build": "npm run build:shared && npm run build:backend && npm run build:frontend && npm run build:agent && npm run build:wechat && npm run build:memory && npm run build:gateway",
    "start:gateway": "npm run start --workspace modelgateway",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
