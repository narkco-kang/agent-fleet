# ── 后端协调服务 ─────────────────────────────────────────────
BACKEND_PORT=4173
BACKEND_HOST=0.0.0.0
DB_PATH=./data/agentmesh.db
# 配对码 TTL（毫秒），默认 5 分钟
PAIR_CODE_TTL_MS=300000
# 心跳超时（毫秒），默认 30s
HEARTBEAT_TIMEOUT_MS=30000

# ── 中继服务 ────────────────────────────────────────────────
RELAY_PORT=4174
RELAY_HOST=0.0.0.0
# 中继鉴权 secret（设备/协调服务出站连接时携带，可选）
RELAY_SECRET=

# ── 设备守护进程 ────────────────────────────────────────────
DEVICE_NAME=My Device
# 协调服务直连地址（mDNS 不可用时降级）：ws://<host>:4173/ws
COORDINATOR_URL=
# 中继地址（云端兜底）：ws://<host>:4174/ws
RELAY_URL=
# 设备持久化目录
DEVICE_DATA_DIR=~/.agentmesh

# ── 微信网关 ────────────────────────────────────────────────
WECHAT_PORT=4175
WECHAT_HOST=0.0.0.0
# 企业微信应用配置
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# 后端协调服务地址（供 bridge 调用）
WECHAT_BACKEND_URL=http://127.0.0.1:4173
