# ── 后端协调服务 ─────────────────────────────────────────────
BACKEND_PORT=4173
BACKEND_HOST=0.0.0.0
DB_PATH=./data/agentmesh.db
# 配对码 TTL（毫秒），默认 5 分钟
PAIR_CODE_TTL_MS=300000
# 心跳超时（毫秒），默认 30s
HEARTBEAT_TIMEOUT_MS=30000

# ── 中继服务 ────────────────────────────────────────────────
RELAY_PORT=4174
RELAY_HOST=0.0.0.0
# 中继鉴权 secret（设备/协调服务出站连接时携带，可选）
RELAY_SECRET=

# ── 设备守护进程 ────────────────────────────────────────────
DEVICE_NAME=My Device
# 协调服务直连地址（mDNS 不可用时降级）：ws://<host>:4173/ws
COORDINATOR_URL=
# 中继地址（云端兜底）：ws://<host>:4174/ws
RELAY_URL=
# 设备持久化目录
DEVICE_DATA_DIR=~/.agentmesh

# ── 微信网关 ────────────────────────────────────────────────
WECHAT_PORT=4175
WECHAT_HOST=0.0.0.0
# 企业微信应用配置
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_CORP_SECRET=
WECOM_TOKEN=
WECOM_ENCODING_AES_KEY=
# 后端协调服务地址（供 bridge 调用）
WECHAT_BACKEND_URL=http://127.0.0.1:4173

# ── 内置 modelgateway（协调器本机组件）────────────────────────
# 监听地址/端口（后端默认经 http://127.0.0.1:18765 对接，见 MODELGATEWAY_URL）
MODELGATEWAY_PORT=18765
MODELGATEWAY_HOST=127.0.0.1
# 后端启动后自动 spawn modelgateway（默认手动启动；设为 1 自动启动）
MODELGATEWAY_AUTO_START=0
# 付费 provider 池（JSON 数组）。也可在前端「路由网关 → 付费 Provider」批量配置到本机 .workbuddy-ai/modelgateway-providers.json。
# 环境变量同 id 优先级更高；apiKey 不进仓库，前端仅脱敏回显。
# 例：[{"id":"deepseek","label":"DeepSeek","baseUrl":"https://api.deepseek.com/v1","apiKey":"sk-xxx","models":["deepseek-chat"]}]
MG_PAID_PROVIDERS=[]

# ── 免费源签到/额度刷新 ───────────────────────────────────────
# 是否启用定时自动签到（默认启用）；启动后是否延迟执行一次；定时间隔默认 6 小时。
FREE_CHECKIN_ENABLED=1
FREE_CHECKIN_ON_START=1
FREE_CHECKIN_START_DELAY_MS=5000
FREE_CHECKIN_INTERVAL_MS=21600000
# OpenCode 等没有公开签到端点，若用户获得有效端点可在此配置后自动纳入签到源。
FREE_OPENCODE_CHECKIN_URL=
